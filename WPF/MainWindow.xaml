<Window x:Class="SdxChannelManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SDX Channel Manager" Height="750" Width="1300"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Value Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:TypeToEmojiConverter x:Key="TypeToEmojiConverter" xmlns:local="clr-namespace:SdxChannelManager.ViewModels"/>
        
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ToggleButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#4CAF50"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BDBDBD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListBox Item Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="White" Padding="15" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="📂 Open" 
                            Command="{Binding OpenFileCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            ToolTip="Open an SDX database file"/>
                    <Button Content="💾 Save" 
                            Command="{Binding SaveFileCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            ToolTip="Save changes to the current file"/>
                    <Button Content="💾 Save As..." 
                            Command="{Binding SaveAsFileCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            ToolTip="Save as a new SDX file"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter Toolbar -->
        <Border Grid.Row="1" Background="White" Padding="15" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Show:" 
                           VerticalAlignment="Center" 
                           FontSize="14" 
                           FontWeight="Medium"
                           Margin="0,0,10,0"
                           Foreground="#555"/>
                <RadioButton Content="📺 TV Channels" 
                             IsChecked="{Binding ShowTvChannels}"
                             Command="{Binding ShowTvCommand}"
                             Style="{StaticResource ToggleButtonStyle}"
                             ToolTip="Show TV channels only"/>
                <RadioButton Content="🔊 Radio Channels" 
                             IsChecked="{Binding ShowRadioChannels}"
                             Command="{Binding ShowRadioCommand}"
                             Style="{StaticResource ToggleButtonStyle}"
                             ToolTip="Show radio channels only"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Statistics Panel -->
            <Border Grid.Column="0" Background="White" 
                    CornerRadius="8" Padding="15" Margin="0,0,10,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📊 File Statistics" 
                               FontSize="16" FontWeight="Bold" 
                               Margin="0,0,0,15"
                               Foreground="#333"/>
                    
                    <Border Background="#E3F2FD" CornerRadius="4" Padding="10" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="TV Channels" FontSize="11" Foreground="#555" FontWeight="Medium"/>
                            <TextBlock Text="{Binding TotalTvChannels, FallbackValue='0'}" 
                                       FontSize="24" FontWeight="Bold" Foreground="#2196F3"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#FFF3E0" CornerRadius="4" Padding="10" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="Radio Channels" FontSize="11" Foreground="#555" FontWeight="Medium"/>
                            <TextBlock Text="{Binding TotalRadioChannels, FallbackValue='0'}" 
                                       FontSize="24" FontWeight="Bold" Foreground="#FF9800"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#E8F5E9" CornerRadius="4" Padding="10" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="Satellites" FontSize="11" Foreground="#555" FontWeight="Medium"/>
                            <TextBlock Text="{Binding TotalSatellites, FallbackValue='0'}" 
                                       FontSize="24" FontWeight="Bold" Foreground="#4CAF50"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#F3E5F5" CornerRadius="4" Padding="10" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="Transponders" FontSize="11" Foreground="#555" FontWeight="Medium"/>
                            <TextBlock Text="{Binding TotalTransponders, FallbackValue='0'}" 
                                       FontSize="24" FontWeight="Bold" Foreground="#9C27B0"/>
                        </StackPanel>
                    </Border>
                    
                    <Separator Margin="0,15"/>
                    
                    <TextBlock Text="📁 File Info" 
                               FontSize="12" FontWeight="Bold" 
                               Margin="0,10,0,10"
                               Foreground="#555"/>
                    
                    <TextBlock Text="{Binding FileName, FallbackValue='No file loaded'}" 
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="#757575" Margin="0,2"/>
                    
                    <TextBlock Text="{Binding FileSize, FallbackValue=''}" 
                               FontSize="10"
                               Foreground="#999" Margin="0,5"/>
                </StackPanel>
            </Border>

            <!-- Channel List -->
            <Border Grid.Column="1" Background="White" 
                    CornerRadius="8" Padding="10"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Channel List Header -->
                    <Grid Grid.Row="0" Margin="10,5,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="Channels" 
                                   FontSize="18" FontWeight="Bold" 
                                   Foreground="#333"
                                   VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding Channels.Count, StringFormat='{}{0} items'}" 
                                       FontSize="12" Foreground="#757575"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </StackPanel>
                        
                        <!-- Search TextBox -->
                        <TextBox Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,10,0,0"
                                 FontSize="13"
                                 Padding="8,6"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="🔍 Search channels..." 
                                                                       Foreground="#AAAAAA" 
                                                                       FontSize="13"
                                                                       Margin="5,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <!-- Welcome Screen -->
                    <Grid Grid.Row="1" x:Name="WelcomePanel" 
                          Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📺" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <TextBlock Text="Welcome to SDX Channel Manager" 
                                       FontSize="20" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Foreground="#333"/>
                            <TextBlock Text="Open an SDX file to get started" 
                                       FontSize="14" 
                                       HorizontalAlignment="Center" 
                                       Foreground="#757575" Margin="0,10,0,30"/>
                            <Button Content="📂 Open SDX File" 
                                    Command="{Binding OpenFileCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Padding="30,15" FontSize="14"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Channel List -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Channels}"
                             SelectedItem="{Binding SelectedChannel}"
                             Background="Transparent"
                             BorderThickness="0"
                             Visibility="{Binding ShowChannels, Converter={StaticResource BoolToVisibilityConverter}}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                               Text="{Binding Index}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#2196F3"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,10,0"/>

                                    <TextBlock Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                               Text="{Binding Type, Converter={StaticResource TypeToEmojiConverter}}"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Grid.Column="2" Grid.Row="0"
                                               Text="{Binding ServiceName}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    
                                    <TextBlock Grid.Column="2" Grid.Row="1"
                                               Text="{Binding SatelliteName}"
                                               FontSize="10"
                                               Foreground="#999"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>

                                    <StackPanel Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Border Background="#E3F2FD" CornerRadius="3" Padding="5,2" Margin="2,0">
                                            <TextBlock Text="{Binding Type}"
                                                       FontSize="10"
                                                       FontWeight="Medium"
                                                       Foreground="#2196F3"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Control Panel -->
            <Border Grid.Column="2" Background="White" 
                    CornerRadius="8" Padding="15" Margin="10,0,0,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="⚡ Actions" 
                               FontSize="16" FontWeight="Bold" 
                               Margin="0,0,0,15"
                               Foreground="#333"/>

                    <Button Content="⬆ Move Up" 
                            Command="{Binding MoveUpCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#4CAF50"
                            HorizontalAlignment="Stretch"
                            Margin="0,5"
                            ToolTip="Move selected channel up in the list"/>

                    <Button Content="⬇ Move Down" 
                            Command="{Binding MoveDownCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#FF9800"
                            HorizontalAlignment="Stretch"
                            Margin="0,5"
                            ToolTip="Move selected channel down in the list"/>
                    
                    <Separator Margin="0,15"/>
                    
                    <TextBlock Text="Move to Index" 
                               FontSize="14" FontWeight="Bold" 
                               Margin="0,5,0,10"
                               Foreground="#555"/>
                    
                    <TextBox Text="{Binding TargetIndexText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13"
                             Padding="8,6"
                             Margin="0,5"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Enter index (e.g., 0, 10, 100)..." 
                                                                   Foreground="#AAAAAA" 
                                                                   FontSize="11"
                                                                   Margin="5,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    
                    <Button Content="📍 Move to Index" 
                            Command="{Binding MoveToIndexCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#9C27B0"
                            HorizontalAlignment="Stretch"
                            Margin="0,5"
                            ToolTip="Move selected channel to the specified index"/>

                    <Separator Margin="0,20"/>

                    <TextBlock Text="📌 Selected" 
                               FontSize="14" FontWeight="Bold" 
                               Margin="0,10,0,10"
                               Foreground="#555"/>

                    <Border Background="#F5F5F5" 
                            CornerRadius="4" 
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedChannel.ServiceName, FallbackValue='No selection'}" 
                                       FontSize="13"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       Foreground="#333"
                                       Margin="0,0,0,8"/>
                            
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Index:" 
                                           FontSize="10" Foreground="#757575" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding SelectedChannel.Index, FallbackValue='-'}" 
                                           FontSize="10" Foreground="#333" FontWeight="Medium"/>
                            </Grid>
                            
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Type:" 
                                           FontSize="10" Foreground="#757575" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding SelectedChannel.Type, FallbackValue='-'}" 
                                           FontSize="10" Foreground="#333" FontWeight="Medium"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#263238" Padding="15,10">
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="White" 
                       FontSize="12"/>
        </Border>
    </Grid>
</Window>
