<Window x:Class="SdxChannelManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SDX Channel Sorter" Height="700" Width="1100"
        Background="#F5F5F5">
    
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ToggleButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#4CAF50"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BDBDBD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListBox Item Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="White" Padding="15" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="📂 Open" 
                            Command="{Binding OpenFileCommand}"
                            Style="{StaticResource ModernButtonStyle}"/>
                    <Button Content="💾 Save" 
                            Command="{Binding SaveFileCommand}"
                            Style="{StaticResource ModernButtonStyle}"/>
                    <Button Content="💾 Save As..." 
                            Command="{Binding SaveAsFileCommand}"
                            Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter Toolbar -->
        <Border Grid.Row="1" Background="White" Padding="15" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Show:" 
                           VerticalAlignment="Center" 
                           FontSize="14" 
                           FontWeight="Medium"
                           Margin="0,0,10,0"
                           Foreground="#555"/>
                <RadioButton Content="📺 TV Channels" 
                             IsChecked="{Binding ShowTvChannels}"
                             Command="{Binding ShowTvCommand}"
                             Style="{StaticResource ToggleButtonStyle}"/>
                <RadioButton Content="🔊 Radio Channels" 
                             IsChecked="{Binding ShowRadioChannels}"
                             Command="{Binding ShowRadioCommand}"
                             Style="{StaticResource ToggleButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Channel List -->
            <Border Grid.Column="0" Background="White" 
                    CornerRadius="8" Padding="10"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Channels" 
                               FontSize="18" FontWeight="Bold" 
                               Margin="10,5"
                               Foreground="#333"/>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Channels}"
                             SelectedItem="{Binding SelectedChannel}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding Index}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#2196F3"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding ServiceName}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding Type}"
                                               FontSize="11"
                                               Foreground="#757575"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Control Panel -->
            <Border Grid.Column="1" Background="White" 
                    CornerRadius="8" Padding="15" Margin="15,0,0,0"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Width="180">
                <StackPanel>
                    <TextBlock Text="Move Channel" 
                               FontSize="16" FontWeight="Bold" 
                               Margin="0,0,0,20"
                               Foreground="#333"/>

                    <Button Content="⬆ Move Up" 
                            Command="{Binding MoveUpCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#4CAF50"
                            Width="150"
                            Margin="0,5"/>

                    <Button Content="⬇ Move Down" 
                            Command="{Binding MoveDownCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#FF9800"
                            Width="150"
                            Margin="0,5"/>

                    <Border Background="#F5F5F5" 
                            CornerRadius="4" 
                            Padding="10" 
                            Margin="0,30,0,0">
                        <StackPanel>
                            <TextBlock Text="Selected Channel:" 
                                       FontSize="11" 
                                       FontWeight="Bold"
                                       Foreground="#757575"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding SelectedChannel.ServiceName, FallbackValue='None'}" 
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#333"/>
                            <TextBlock Text="{Binding SelectedChannel.Index, StringFormat='Index: {0}', FallbackValue='Index: -'}" 
                                       FontSize="11"
                                       Margin="0,5,0,0"
                                       Foreground="#757575"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#263238" Padding="15,10">
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="White" 
                       FontSize="12"/>
        </Border>
    </Grid>
</Window>
